# NestJS API (Server Components gọi trực tiếp, trình duyệt đi qua rewrite /api/v1)
API_URL=http://localhost:4000
# Socket.IO kết nối thẳng tới API (inline lúc build)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Trùng với REVALIDATE_SECRET của apps/api
REVALIDATE_SECRET=change-me-revalidate
# Địa chỉ công khai của website (sitemap, robots, ảnh chia sẻ) — production: https://ten-mien-cua-ban
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Sentry: bỏ trống thì không gửi lỗi. Lấy DSN trong Sentry → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

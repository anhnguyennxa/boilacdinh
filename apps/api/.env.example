NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://foodhub:foodhub@localhost:5433/foodhub
REDIS_URL=redis://localhost:6380
WEB_URL=http://localhost:3000

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Dùng chung với apps/web để gọi revalidateTag khi admin sửa thực đơn
REVALIDATE_SECRET=change-me-revalidate

# ── Thanh toán (giai đoạn 4) ──
# URL công khai của API: VNPay/MoMo redirect & gọi IPN về đây. Khi test sandbox thật trên máy,
# dùng tunnel (ngrok, cloudflared) rồi đặt URL tunnel vào đây và vào cấu hình IPN của merchant.
API_PUBLIC_URL=http://localhost:4000
# true = dùng cổng giả lập trên máy (ký HMAC thật, không gọi ra ngoài). Luôn tắt khi NODE_ENV=production.
PAYMENT_MOCK=true
# Đơn thanh toán online quá số phút này mà chưa trả sẽ tự hủy
PAYMENT_TTL_MINUTES=15

# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận TMN code + hash secret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo: lấy partner code/access key/secret key test trong trang developers.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn

# ── Ảnh món (giai đoạn 5) ──
# Bỏ trống: lưu vào apps/api/uploads và phục vụ tại /uploads (web proxy qua cùng domain).
# Production nên dùng Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

{
  "name": "foodhub",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @foodhub/api prisma:migrate",
    "db:seed": "pnpm --filter @foodhub/api prisma:seed",
    "db:seed-demo": "pnpm --filter @foodhub/api prisma:seed-demo --",
    "db:backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@nestjs/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
